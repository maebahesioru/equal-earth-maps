{
  "manifest_version": 3,
  "name": "Equal Earth Maps — 地図をイコールアース図法に",
  "short_name": "EqualEarthMaps",
  "version": "1.0.0",
  "description": "OpenStreetMapと国土地理院地図のメルカトル表示を、イコールアース(正積)図法に変換して表示する拡張機能。データ収集・外部送信なし。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.openstreetmap.org/*",
    "*://maps.gsi.go.jp/*",
    "*://tile.openstreetmap.org/*",
    "*://cyberjapandata.gsi.go.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.openstreetmap.org/*",
        "*://maps.gsi.go.jp/*"
      ],
      "js": [
        "lib/math.js",
        "lib/glsl.js",
        "lib/engine.js",
        "lib/sites.js",
        "lib/sources.js",
        "lib/eeslippy.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Equal Earth Maps",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-equal-earth": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "イコールアース表示を切り替え"
    }
  }
}